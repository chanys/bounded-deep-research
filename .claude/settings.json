{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(uv run python -m ingest:*)",
      "Bash(uv run python -m app:*)",
      "Bash(uv run python -m eval:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make logs:*)",
      "Bash(make api:*)",
      "Bash(make web:*)",
      "Bash(make smoke:*)",
      "Bash(make corpus-dump:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform init:*)",
      "Bash(aws ecs:*)",
      "Bash(aws logs:*)",
      "Bash(./scripts/aws-cost-check.sh:*)",
      "Read(.env.example)",
      "WebFetch(domain:developers.openai.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(make corpus-restore:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/*credential*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(make reset:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
